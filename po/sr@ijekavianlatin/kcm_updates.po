#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "Ažuriraj softver:"

#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "Ručno"

#: kcm/ui/main.qml:56
#, kde-format
msgid "Automatically"
msgstr "Automatski"

#: kcm/ui/main.qml:68
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr ""
"Dopune softvera biće automatski preuzete čim postanu dostupne. Dopune "
"programa biće odmah instalirane, a dopune sistema pri sljedećem ponovnom "
"pokretanju."

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "Učestanost ažuriranja:"

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "Učestanost obavještavanja:"

#: kcm/ui/main.qml:79
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "dnevno"

#: kcm/ui/main.qml:80
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "sedmično"

#: kcm/ui/main.qml:81
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "mjesečno"

#: kcm/ui/main.qml:82
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "nikad"

#: kcm/ui/main.qml:120
#, kde-format
msgid "Apply system updates:"
msgstr "Primijeni dopune sistema:"

#: kcm/ui/main.qml:127
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates after "
"rebooting'"
msgid "After rebooting"
msgstr "Poslije ponovnog podizanja"

#: kcm/ui/main.qml:139
#, kde-format
msgctxt ""
"@label The thing being recommended is to use the 'apply updates when "
"rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "Preporučeno radi najveće stabilnosti sistema"

#: kcm/ui/main.qml:145
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "Odmah"
