#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "Programoppdatering:"

#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "Manuell"

#: kcm/ui/main.qml:56
#, kde-format
msgid "Automatically"
msgstr "Automatisk"

#: kcm/ui/main.qml:68
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr ""
"Nye programvare­oppdateringar vert automatisk lasta ned. Oppdateringar for "
"brukar­program vert installerte automatisk, mens oppdateringar for systemet "
"vert installerte neste gong maskina vert starta på nytt."

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "Oppdateringsfrekvens:"

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "Varslingsfrekvens:"

#: kcm/ui/main.qml:79
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "Dagleg"

#: kcm/ui/main.qml:80
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "Vekentleg"

#: kcm/ui/main.qml:81
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "Månadleg"

#: kcm/ui/main.qml:82
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "Aldri"

#: kcm/ui/main.qml:120
#, kde-format
msgid "Apply system updates:"
msgstr "Bruk systemoppdateringar:"

#: kcm/ui/main.qml:127
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates after "
"rebooting'"
msgid "After rebooting"
msgstr "Etter omstart"

#: kcm/ui/main.qml:139
#, kde-format
msgctxt ""
"@label The thing being recommended is to use the 'apply updates when "
"rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "Tilrådd for høgast systemstabilitet"

#: kcm/ui/main.qml:145
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "Med ein gong"
