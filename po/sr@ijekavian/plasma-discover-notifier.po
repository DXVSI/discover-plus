#: notifier/NotifierItem.cpp:50
#, kde-format
msgid "Refresh…"
msgstr "Освјежи…"

#: notifier/NotifierItem.cpp:56
#, kde-format
msgid "Install Updates and Restart…"
msgstr "Инсталирај допуне и поново покрени…"

#: notifier/NotifierItem.cpp:59
#, kde-format
msgid "Install Updates and Shut Down…"
