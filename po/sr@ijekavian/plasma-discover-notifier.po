#, kde-format
msgid "The system needs to be restarted for the updates to take effect."
msgstr "Систем мора да се поново покрене да би допуне ступиле на снагу."

#: notifier/DiscoverNotifier.cpp:404
#, kde-format
msgctxt "@action:button"
msgid "Update and Restart"
msgstr "Ажурирај и поново покрени"

#: notifier/DiscoverNotifier.cpp:405
#, kde-format
msgctxt "@action:button"
msgid "Update and Shut Down"
msgstr "Ажурирај и угаси"

#: notifier/DiscoverNotifier.cpp:449
#, kde-format
msgctxt "A new distro release is available for upgrade"
msgid "Upgrade available"
msgstr "Доступна надоградња"

#: notifier/DiscoverNotifier.cpp:450
#, kde-format
msgctxt "A new distro release (name and version) is available for upgrade"
msgid "%1 is now available."
msgstr "Доступно је ново издање: %1."

#: notifier/DiscoverNotifier.cpp:453
#, kde-format
msgctxt "@action:button Upgrade to new distro release"
msgid "Upgrade"
msgstr "Надогради"

