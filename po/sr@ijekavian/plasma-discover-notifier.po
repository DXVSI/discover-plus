#: notifier/DiscoverNotifier.cpp:218
#, kde-format
msgid "View Updates"
msgstr "Прикажи допуне"

#: notifier/DiscoverNotifier.cpp:363
#, kde-format
msgid "Security updates available"
msgstr "Доступне су безбједносне допуне"

#: notifier/DiscoverNotifier.cpp:365
#, kde-format
msgid "Updates available"
msgstr "Доступне су допуне"

#: notifier/DiscoverNotifier.cpp:367
#, kde-format
msgid "System up to date"
msgstr "Систем је ажуран"

#: notifier/DiscoverNotifier.cpp:369
#, kde-format
msgid "System will install updates when restarted"
msgstr "Систем ће инсталирати допуне при поновном покретању"

